{
  "name": "krypt-marketo",
  "productName": "Krypt Marketo",
  "version": "1.4.1",
  "description": "Make Instagram reels and run Instagram accounts with any AI: preset reel generator, built-in Instagram browser with enforced limits, stats, and an MCP server.",
  "main": "dist-electron/main.js",
  "author": {
    "name": "Krypt",
    "email": "hi@krypt.cc",
    "url": "https://krypt.cc"
  },
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "vite build && electron .",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.json --noEmit",
    "mcp:test": "node scripts/mcp-call.mjs",
    "dist": "vite build && electron-builder",
    "dist:dir": "vite build && electron-builder --dir"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@samasante/liquid-glass": "^0.1.1",
    "@types/node": "^24.19.2",
    "@types/react": "^18.2.74",
    "@types/react-dom": "^18.2.24",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "lucide-react": "^0.368.0",
    "mediabunny": "^1.46.0",
    "onnxruntime-web": "^1.26.0-dev.20260416-b7804b056c",
    "postcss": "^8.4.38",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^3.4.3",
    "three": "^0.170.0",
    "typescript": "^5.4.5",
    "vite": "^5.2.9",
    "vite-plugin-electron": "^0.28.4",
    "vite-plugin-electron-renderer": "^0.14.5",
    "zustand": "^5.0.2"
  },
  "build": {
    "appId": "cc.krypt.marketo",
    "productName": "Krypt Marketo",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "!dist-electron/**/*.map",
      "resources/krypt.ico",
      "resources/krypt.png",
      "research/02-*.md",
      "research/03-*.md",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/mcp",
        "to": "resources/mcp"
      },
      {
        "from": "resources/extension",
        "to": "resources/extension"
      },
      {
        "from": "resources/examples",
        "to": "resources/examples"
      },
      {
        "from": "resources/tools",
        "to": "resources/tools"
      }
    ],
    "asar": true,
    "electronLanguages": [
      "en-US"
    ],
    "electronFuses": {
      "runAsNode": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "publish": null,
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "resources/krypt.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "resources/krypt-mac.png",
      "category": "public.app-category.productivity",
      "identity": "-",
      "hardenedRuntime": false,
      "notarize": false
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "resources/krypt.png",
      "category": "AudioVideo"
    }
  }
}
