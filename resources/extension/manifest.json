{
  "manifest_version": 3,
  "name": "Krypt Marketo",
  "version": "1.1.1",
  "description": "Lets the Krypt Marketo app on this computer use Instagram, X, TikTok, Facebook, Threads, Pinterest, YouTube Studio for uploading Shorts, and Content Rewards for campaign submissions, in this Chrome profile, under Marketo's limits. Works only on those sites.",
  "key": "",
  "minimum_chrome_version": "116",
  "icons": {
    "128": "icon.png"
  },
  "action": {
    "default_title": "Krypt Marketo",
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "debugger",
    "nativeMessaging",
    "cookies",
    "alarms",
    "storage",
    "proxy",
    "webRequest",
    "webRequestAuthProvider",
    "privacy"
  ],
  "host_permissions": [
    "https://*.instagram.com/*",
    "https://*.youtube.com/*",
    "https://x.com/*",
    "https://*.x.com/*",
    "https://*.twitter.com/*",
    "https://*.tiktok.com/*",
    "https://*.facebook.com/*",
    "https://*.threads.com/*",
    "https://*.threads.net/*",
    "https://*.pinterest.com/*",
    "https://*.pinterest.co.uk/*",
    "https://*.pinterest.ca/*",
    "https://*.pinterest.com.au/*",
    "https://*.pinterest.de/*",
    "https://*.pinterest.fr/*",
    "https://contentrewards.com/*",
    "https://*.contentrewards.com/*",
    "https://ipinfo.io/*"
  ]
}
